# Single source of truth for every pinned tool. Read by scripts/toolchain/*.sh
# and by CI (cache keys hash this file). Bump here, nowhere else.

AGAVE_VERSION=4.2.2
# One tarball per host platform, each pinned to the sha256 GitHub publishes for
# the release asset.
AGAVE_TARBALL_SHA256_X86_64_LINUX=5fc8684f7430038105fde953d4308ed56addf627f658daa61709f345448247ee
AGAVE_TARBALL_SHA256_AARCH64_DARWIN=580bb4bcdb439756645a83d856964a8d7b700512356ada819ad89a40bd76bca4
PLATFORM_TOOLS=v1.57
# SBPF architecture the program is built for. v3 is active on mainnet (feature
# enable_sbpf_v3_deployment_and_execution = 5cC3foj77CWun58pC51ebHFUWavHWKarWyR5UUik7dnC,
# slot 428 976 000) and on devnet; see tests/fixtures/features/. Do not trust the
# CLI's `feature status` table for this: in Agave 4.2.2 it still lists v3 under a
# retired id (C8XZNs…) and reports it inactive. The runtime crate and the on-chain
# feature account are the truth. CI also builds v0 so the fallback stays alive.
SBF_ARCH=v3
ANCHOR_CLI=1.2.0
RUST_HOST=1.98.1
NODE_MAJOR=24
PNPM_VERSION=12.4.2
