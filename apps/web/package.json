{
  "name": "@fade/web",
  "version": "0.0.0",
  "private": true,
  "description": "Fade web app: demos and the liquidity-provider dashboard, on devnet",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
