// Cloudflare deployment of the Fade keeper: a Worker serving
// the app's API at api.fade.finance, and one SQLite-backed Durable Object that
// cranks tickets and epochs on an alarm.
//
// Secrets: KEEPER_SECRET_KEY (the keeper's 64-byte keypair as a JSON array) and
// FAUCET_SECRET_KEY (the faucet's own keypair, same format).
// Optional: RPC_URL (defaults to the public devnet endpoint; set it as a secret
// to use a keyed provider).
// All-time figures (src/stats.ts, GET /v1/stats; GET /v1/apr, /v1/vault, /v1/feed and
// /v1/providers too): a third Durable Object that reads the program's history on its own
// alarm. It needs no secret. It also holds the live push's WebSockets (GET /v1/live,
// src/liveHub.ts), with the Hibernation API: no binding or migration of its own.
// The shared beacon (src/beacon.ts, GET /v1/beacon): a fourth Durable Object on the keeper's
// own program, on while BEACON_ENABLED below is "true" (or "1"; "false" is the kill switch),
// signing with the secret BEACON_SECRET_KEY (its own keypair, never KEEPER_SECRET_KEY; set by
// the deploy workflow from the repository secret of that name); optional BEACON_USDC_MINT, BEACON_MIN_BALANCE_LAMPORTS
// (the floor below which it stops the steps that earn nothing, 0.1 SOL by default), the automatic
// sponsor (BEACON_SPONSOR_LAMPORTS_PER_USDC, BEACON_SPONSOR_INTEGRATORS,
// BEACON_SPONSOR_MAX_LAMPORTS; off unless the first is set), BEACON_PUSH_REFUNDS,
// BEACON_SWEEP_MIN_UNITS ("off" to stop sweeping), BEACON_TX_FORMAT (1 or 0).
// BEACON_ACKNOWLEDGED_ALARMS below: the operator's acknowledgement of alarms reviewed and found
// to be false positives, a JSON array of { "round": "<round address>", "kind": "<alarm kind>",
// "reason": "<why, 200 characters at most>" }. Each entry resolves only the alarm of that exact
// round and kind (kept as history on GET /v1/beacon, with its reason; no longer counted by
// pauseRecommended); it never silences another kind on that round, nor any other round's alarm,
// and low-balance cannot be acknowledged. A list that does not parse is ignored as a whole
// (nothing resolved, the loop still runs) and reported as acknowledgementError on GET /v1/beacon.
// It is configuration on purpose, with no route to write it: every change goes through a
// reviewed commit and a deploy.
// DIRECT_ACKNOWLEDGED_WITHHELD (optional): the same for the direct path's withheld alarm, a JSON
// array of { "ordinal": <its Vault.ticket_forfeits_withheld ordinal>, "reason": "<why>" }. Every
// direct expiry the vault counts recommends the pause (GET /v1/health and GET /v1/beacon,
// pauseRecommended) until its ordinal is listed here; a list that does not parse is ignored as a
// whole and reported as directWithheld.acknowledgementError on GET /v1/health.
// Deploy with: cd apps/keeper && npx -y wrangler@4.147.0 deploy
{
  "name": "fade-keeper",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "routes": [{ "pattern": "api.fade.finance", "custom_domain": true }],
  "durable_objects": {
    "bindings": [
      { "name": "KEEPER", "class_name": "Keeper" },
      { "name": "FAUCET", "class_name": "Faucet" },
      { "name": "STATS", "class_name": "Stats" },
      { "name": "BEACON", "class_name": "BeaconKeeper" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Keeper"] },
    { "tag": "v2", "new_sqlite_classes": ["Faucet"] },
    { "tag": "v3", "new_sqlite_classes": ["Bots"] },
    { "tag": "v4", "new_sqlite_classes": ["Stats"] },
    // v3's class is retired: deleting it is how a Durable Object class leaves a Worker.
    { "tag": "v5", "deleted_classes": ["Bots"] },
    { "tag": "v6", "new_sqlite_classes": ["BeaconKeeper"] },
  ],
  "vars": {
    "BEACON_ENABLED": "true",
    // Round 7: reviewed, a false positive.
    "BEACON_ACKNOWLEDGED_ALARMS": "[{\"round\": \"DvRPRsUZYeQmZy7xDhpeNKom1WGwf4JVpTYXbyaamEGw\", \"kind\": \"withheld-draw\", \"reason\": \"reviewed false positive: the round was refunded and its entropy never recorded, not a withheld draw\"}]",
  },
  // Per-IP limit of the JSON-RPC proxy and of the write routes.
  "ratelimits": [
    { "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 100, "period": 10 } },
  ],
  // A safety net: restarts the Durable Object's alarm should it ever stop.
  "triggers": { "crons": ["*/5 * * * *"] },
  "observability": { "enabled": true },
}
